{
  "name": "@tabschat/miniapp-sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "Portable developer kit for Tabs HTTPS mini-apps",
  "engines": {
    "node": ">=24.12"
  },
  "exports": {
    "./bootstrap": "./src/bootstrap.js",
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./dev/mock-host": {
      "types": "./dev/mock-host.d.ts",
      "default": "./dev/mock-host.js"
    },
    "./server/auth": {
      "types": "./server/auth.d.mts",
      "default": "./server/auth.mjs"
    }
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabschat-at/miniapp-sdk.git"
  },
  "homepage": "https://developers.tabschat.com",
  "bugs": {
    "url": "https://github.com/tabschat-at/miniapp-sdk/issues"
  },
  "keywords": [
    "tabs",
    "miniapp",
    "atproto",
    "sdk"
  ],
  "files": [
    "src/",
    "server/",
    "dev/mock-host.js",
    "dev/mock-host.d.ts",
    "dev-tools/",
    "tools/validate.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "tabs-miniapp-validate": "tools/validate.mjs",
    "tabs-miniapp-simulate": "dev-tools/simulator/server.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@atproto/lexicon": "0.7.15",
    "esbuild": "0.25.12",
    "marked": "18.1.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "dev": "node dev/server.mjs",
    "simulator": "node dev-tools/simulator/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node tools/validate.mjs",
    "check": "node tools/check.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "docs:build": "node tools/build-docs.mjs",
    "check:package": "node tools/check-package.mjs",
    "prepublishOnly": "npm run check && npm run typecheck",
    "dev-tools:build": "node tools/build-dev-tools.mjs"
  }
}
