{
  "lexicon": 1,
  "id": "org.example.recipes.recipe",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["title", "ingredients"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "ingredients": {
            "type": "array",
            "maxLength": 30,
            "items": { "type": "ref", "ref": "#ingredient" }
          },
          "notes": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "ingredient": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    }
  }
}
